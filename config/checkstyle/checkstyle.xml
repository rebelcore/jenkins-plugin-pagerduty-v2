<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  The Rebel Media Checkstyle rules, identical in every Java project.

  Layout and whitespace are not checked here: palantir-java-format (Spotless)
  owns them, and two tools with opinions about the same thing only fight. These
  rules cover what a formatter cannot fix: names, risky constructs, and the
  documentation a public type owes its reader.

  Suppress a finding on one line with a comment explaining why:
    // CHECKSTYLE.OFF: RuleName - reason
    ...
    // CHECKSTYLE.ON: RuleName
-->
<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <property name="severity" value="error"/>
  <property name="fileExtensions" value="java"/>

  <module name="SuppressWithPlainTextCommentFilter">
    <property name="offCommentFormat" value="CHECKSTYLE.OFF\: ([\w\|]+)"/>
    <property name="onCommentFormat" value="CHECKSTYLE.ON\: ([\w\|]+)"/>
    <property name="checkFormat" value="$1"/>
  </module>

  <!-- Tests describe behaviour in their method names; they do not need Javadoc. -->
  <module name="SuppressionSingleFilter">
    <property name="checks" value="Javadoc"/>
    <property name="files" value="[\\/]src[\\/]test[\\/]"/>
  </module>

  <module name="FileTabCharacter"/>
  <module name="NewlineAtEndOfFile">
    <property name="lineSeparator" value="lf"/>
  </module>

  <module name="TreeWalker">
    <!-- Imports: explicit, used, and never from JDK internals. -->
    <module name="AvoidStarImport"/>
    <module name="RedundantImport"/>
    <module name="UnusedImports"/>
    <module name="IllegalImport">
      <property name="illegalPkgs" value="sun, com.sun.proxy, jdk.internal"/>
    </module>

    <!-- Names: the Java conventions, so code reads the same everywhere. -->
    <module name="PackageName">
      <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
    </module>
    <module name="TypeName"/>
    <module name="MethodName"/>
    <module name="MemberName"/>
    <module name="ParameterName"/>
    <module name="LocalVariableName"/>
    <module name="LocalFinalVariableName"/>
    <module name="StaticVariableName"/>
    <module name="ConstantName"/>
    <module name="ClassTypeParameterName"/>
    <module name="MethodTypeParameterName"/>

    <!-- Constructs that are almost always a mistake. -->
    <module name="EqualsHashCode"/>
    <module name="StringLiteralEquality"/>
    <module name="EmptyCatchBlock">
      <property name="exceptionVariableName" value="expected|ignored"/>
    </module>
    <module name="EmptyStatement"/>
    <module name="FallThrough"/>
    <module name="MissingSwitchDefault"/>
    <module name="SimplifyBooleanExpression"/>
    <module name="SimplifyBooleanReturn"/>
    <module name="OneStatementPerLine"/>
    <module name="MultipleVariableDeclarations"/>
    <module name="NeedBraces"/>
    <module name="UpperEll"/>
    <module name="ArrayTypeStyle"/>
    <module name="ModifierOrder"/>
    <module name="HideUtilityClassConstructor"/>
    <module name="FinalClass"/>
    <module name="MissingOverride"/>

    <!-- Output goes through the logger, where it has a level and a source. -->
    <module name="RegexpSinglelineJava">
      <property name="format" value="System\.(out|err)\.print|\.printStackTrace\(\)"/>
      <property name="ignoreComments" value="true"/>
      <property name="message" value="Use the logger, not System.out, System.err or printStackTrace()."/>
    </module>

    <!-- A public type says what it is for. -->
    <module name="MissingJavadocType">
      <property name="scope" value="public"/>
    </module>
    <module name="InvalidJavadocPosition"/>
  </module>
</module>
